# OPTIONAL SERVER-ONLY integrations. Set real values in Supabase Edge Function Secrets.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
CRON_SECRET=
ALLOWED_ORIGINS=
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY on hosted functions.
# Never put a service-role or provider key in VITE_* variables or the APK.

# OneSignal server only. App ID is public and fixed in the app/server code.
ONESIGNAL_REST_API_KEY=
# Download the matching ES256 private PEM from OneSignal Identity Verification.
# Preserve PEM newlines or encode them as literal \n in the secret value.
ONESIGNAL_IDENTITY_VERIFICATION_SECRET_KEY=
# Random >=32-character worker secret, same value in private DB configuration.
PUSH_WEBHOOK_SECRET=
